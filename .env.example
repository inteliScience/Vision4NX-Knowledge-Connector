# Open WebUI / Vision 4 NX instance (required)
OPENWEBUI_URL=http://localhost:3000
# User API key from Open WebUI: Settings -> Account -> API Keys (required)
OPENWEBUI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# MCP server bind (optional)
MCP_HOST=0.0.0.0
MCP_PORT=8600

# Reserved for future client auth — currently IGNORED, auth is stubbed
MCP_AUTH_TOKEN=

LOG_LEVEL=INFO
