# Vision 4 NX instance URL (required) — issued by Inteliscience (info@inteliscience.net)
VISION4NX_URL=https://your-vision4nx-instance
# Service access token (required) — issued by Inteliscience (info@inteliscience.net)
VISION4NX_API_KEY=

# Chunks retrieved per collection before reranking (optional)
RETRIEVAL_CANDIDATE_POOL=40

# MCP server bind (optional)
MCP_HOST=0.0.0.0
MCP_PORT=8600

# Client auth: bearer tokens the MCP clients must send (comma-separated, one per customer).
# Empty = every client is accepted (the server logs a warning). /health stays open.
MCP_AUTH_TOKENS=
# Single-token form (older deployments); counts in addition to MCP_AUTH_TOKENS
MCP_AUTH_TOKEN=

LOG_LEVEL=INFO
